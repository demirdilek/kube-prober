{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Executive Overview & SLO Health",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Global Availability (5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "(1 - (sum(rate(kube_prober_errors_total[5m])) / clamp_min(sum(rate(kube_prober_traffic_total[5m])), 0.001))) * 100",
          "legendFormat": "Availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99.0 },
              { "color": "green", "value": 99.9 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "SLO Error Budget Burn Rate (1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "max(target:kube_prober_error_ratio:rate1h / 0.001) or vector(0)",
          "legendFormat": "Max Burn Rate Factor"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2.0 },
              { "color": "red", "value": 14.4 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Active Prober Alerts",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "expr": "sum(ALERTS{alertstate=\"firing\", app=\"kube-prober\"}) or vector(0)",
          "legendFormat": "Firing Alerts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "4 Golden Signals",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "id": 6,
      "title": "Latency (p99 / p95 / p50)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(kube_prober_latency_seconds_bucket{le!=\"\"}[$__rate_interval])) by (le, target))",
          "legendFormat": "{{target}} (p99)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(kube_prober_latency_seconds_bucket{le!=\"\"}[$__rate_interval])) by (le, target))",
          "legendFormat": "{{target}} (p95)"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(kube_prober_latency_seconds_bucket{le!=\"\"}[$__rate_interval])) by (le, target))",
          "legendFormat": "{{target}} (p50)"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" }, "unit": "s" }
      }
    },
    {
      "id": 7,
      "title": "Traffic (Probes / sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(kube_prober_traffic_total[$__rate_interval])) by (target)",
          "legendFormat": "{{target}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" }, "unit": "cps" }
      }
    },
    {
      "id": 8,
      "title": "Errors by SRE Category",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum(rate(kube_prober_errors_total[$__rate_interval])) by (target, category)",
          "legendFormat": "{{target}} [{{category}}]"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" }, "unit": "cps", "noValue": "0" }
      }
    },
    {
      "id": 9,
      "title": "Worker Capacity Saturation %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "(sum(kube_prober_saturation_active_workers) / clamp_min(max(kube_prober_saturation_max_workers), 1)) * 100",
          "legendFormat": "Worker Pool Saturation"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" }, "unit": "percent" }
      }
    },
    {
      "id": 10,
      "title": "Protocol & Certificate Health",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "TLS Certificate Expiry (Days Remaining)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "kube_prober_tls_cert_expiry_days",
          "legendFormat": "{{target}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 7 },
              { "color": "green", "value": 30 }
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "title": "TCP Target Availability",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 23 },
      "targets": [
        {
          "expr": "clamp_min(clamp_max((1 - (sum(rate(kube_prober_errors_total{target=~\"tcp://.*\"}[2m])) / clamp_min(sum(rate(kube_prober_traffic_total{target=~\"tcp://.*\"}[2m])), 0.001))) * 100, 100), 0)",
          "legendFormat": "TCP Availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99.9 }
            ]
          }
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["sre", "network", "golden-signals"],
  "time": { "from": "now-15m", "to": "now" },
